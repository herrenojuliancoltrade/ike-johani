# ===================== Django =====================
SECRET_KEY=cambia-esta-clave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=America/Bogota

# Solo producción (DEBUG=False). Render define RENDER_EXTERNAL_HOSTNAME solo.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=0
# LOG_LEVEL=INFO

# ===================== Base de datos =====================
# Si DATABASE_URL existe, tiene prioridad sobre DB_ENGINE/DB_* (Render la inyecta)
# DATABASE_URL=postgres://usuario:clave@host:5432/ike_asistencias
# DB_SSL_REQUIRE=False   # True si usas la URL *externa* de Render
# sqlite (desarrollo) | postgresql (producción)
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# Variables de PostgreSQL (se usan cuando DB_ENGINE=postgresql)
DB_NAME=ike_asistencias
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# SSL: require para bases en la nube (Render, AWS...), disable para PostgreSQL local
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# ===================== JWT =====================
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ===================== CORS (frontend) =====================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ===================== Paginación =====================
PAGE_SIZE=20

# ===================== Reglas de asignación =====================
ASIG_MINUTOS_ALISTAMIENTO=10
ASIG_VELOCIDAD_DEFECTO_KMH=30
ASIG_PESO_DISTANCIA=1.0
ASIG_PESO_CARGA=2.0
ASIG_PESO_CALIFICACION=1.5
