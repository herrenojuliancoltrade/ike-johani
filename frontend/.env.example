# URL base de la API de Django (backend/). Debe terminar en /api
VITE_API_URL=http://127.0.0.1:8000/api

# Cada cuántos milisegundos se consulta el estado de una asistencia (seguimiento)
VITE_POLLING_MS=10000

# Teléfono de la línea de asistencia 24/7 que se muestra en el menú (opcional)
VITE_LINEA_ASISTENCIA=
